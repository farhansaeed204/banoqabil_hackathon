# Copy to .env.local and fill in your real values.
# NEVER commit .env.local — this example file is safe to commit.

# Supabase (public sharing) — server-only vars (no browser exposure)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_key

# Google Gemini (optional; round-robin across 3 keys for rate limits)
GEMINI_API_KEY=your_key
GEMINI_API_KEY_2=your_key_2
GEMINI_API_KEY_3=your_key_3
